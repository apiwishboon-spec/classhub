{
  "firestore": {
    "rules": "firestore.rules"
  },
  "functions": {
    "source": "functions",
    "ignore": [
      ".git",
      "node_modules"
    ]
  },
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "functions/**"
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          { "key": "X-Content-Type-Options", "value": "nosniff" },
          { "key": "X-Frame-Options", "value": "DENY" },
          { "key": "X-XSS-Protection", "value": "1; mode=block" },
          { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
          { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
        ]
      }
    ],
    "rewrites": [
      {
        "source": "/ad-inquiry",
        "destination": "/ad-inquiry.html"
      },
      {
        "source": "/ad-renew",
        "destination": "/ad-renew.html"
      },
      {
        "source": "/admin",
        "destination": "/admin.html"
      },
      {
        "source": "/chat",
        "destination": "/chat.html"
      },
      {
        "source": "/contact",
        "destination": "/contact.html"
      },
      {
        "source": "/pass-change",
        "destination": "/pass-change.html"
      },
      {
        "source": "/privacy",
        "destination": "/privacy.html"
      },
      {
        "source": "/terms",
        "destination": "/terms.html"
      },
      {
        "source": "/vote",
        "destination": "/vote.html"
      },
      {
        "source": "/export",
        "destination": "/export.html"
      },
      {
        "source": "/maintenance",
        "destination": "/maintenance.html"
      },
      {
        "source": "/camo",
        "destination": "/camo.html"
      },
      {
        "source": "/camo-chat",
        "destination": "/camo-chat.html"
      },
      {
        "source": "/camo-admin",
        "destination": "/camo-admin.html"
      },
      {
        "source": "/camochat",
        "destination": "/camochat.html"
      },
      {
        "source": "**",
        "destination": "/404.html"
      }
    ]
  }
}