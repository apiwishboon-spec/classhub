rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to fetch the role of the authenticated user from /users/{uid}
    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    // 1. Homework collection
    // Read: Anyone (students and staff)
    // Write: Admins, Teachers, and TAs
    match /homework/{id} {
      allow read: if true;
      allow write: if request.auth != null && (
        getUserRole() == 'admin' || 
        getUserRole() == 'teacher' || 
        getUserRole() == 'ta'
      );
    }
    
    // 2. Announcements collection
    // Read: Anyone (students and staff)
    // Write: Admins and Teachers only
    match /announcements/{id} {
      allow read: if true;
      allow write: if request.auth != null && (
        getUserRole() == 'admin' || 
        getUserRole() == 'teacher'
      );
    }
    
    // 3. Schedule collection
    // Read: Anyone (students and staff)
    // Write: Admins only
    match /schedule/{id} {
      allow read: if true;
      allow write: if request.auth != null && getUserRole() == 'admin';
    }

    // 4. Users collection
    // Read: Any logged-in staff member can read user profiles
    // Write: Admins only (only admins can assign/edit roles)
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (getUserRole() == 'admin' || request.auth.uid == userId);
    }
    
    // 5. FCM Tokens collection
    // Read/Write: Anyone (so browsers can register their push notification tokens anonymously)
    match /fcm_tokens/{token} {
      allow read, write: if true;
    }

    // 6. Audit Log collection
    // Write: Any staff member performing an action
    // Read: Admins only
    match /audit_log/{id} {
      allow write: if request.auth != null && (
        getUserRole() == 'admin' || 
        getUserRole() == 'teacher' || 
        getUserRole() == 'ta'
      );
      allow read: if request.auth != null && getUserRole() == 'admin';
    }

    // 7. Settings collection
    // Read: Anyone (to check maintenance mode and staff status)
    // Write: Admins only
    match /settings/{id} {
      allow read: if true;
      allow write: if request.auth != null && getUserRole() == 'admin';
    }

    // 8. Page Visits collection
    // Read: Anyone
    // Write: Anyone
    match /page_visits/{pageId} {
      allow read, write: if true;
    }

    // 9. Polls collection
    match /polls/{pollId} {
      allow read: if true;
      allow create, delete: if request.auth != null && (
        getUserRole() == 'admin' || 
        getUserRole() == 'teacher'
      );
      allow update: if true; // Allow anyone to vote (increment)
    }

    // 10. Feedback collection
    match /feedback/{id} {
      allow create: if true;
      allow read, update: if true; // Allow anyone to read/update for conversations
      allow delete: if request.auth != null && (
        getUserRole() == 'admin' || 
        getUserRole() == 'teacher'
      );
    }

    // 11. Bug Reports collection
    //  Create: Anyone (students and staff)
    //  Read/Update/Delete: Admins only
    match /bugs/{id} {
      allow create: if true;
      allow read, update, delete: if request.auth != null && getUserRole() == 'admin';
    }
  }
}
